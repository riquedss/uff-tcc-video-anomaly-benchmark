FROM pytorch/pytorch:2.0.1-cuda11.7-cudnn8-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        make \
        gcc \
        g++ \
        pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --only-binary=av \
    "matplotlib==3.7.2" \
    "torchvision==0.15.2" \
    "pandas==2.0.3" \
    "tqdm==4.65.0" \
    "pyyaml==6.0.1" \
    "scipy==1.10.1" \
    "scikit-learn==1.3.0" \
    "av==12.3.0" \
    "opencv-python-headless" \
    "tensorboard==2.10.0"

COPY . /app/AnomalyDetectionCVPR2018-Pytorch

WORKDIR /app/AnomalyDetectionCVPR2018-Pytorch

CMD ["python", "TrainingAnomalyDetector_public.py"]
