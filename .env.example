# Copie para .env e ajuste. O .env NÃO é versionado.

# Diretório na máquina host com os datasets/features. Montado como /data
# dentro de todos os containers. Ver docs/DATASETS.md para o layout.
DATA_ROOT=/caminho/para/dados

# Caminho DENTRO do container para as features I3D do PEL4VAD.
# Sobrescreve o valor hardcoded em models/PEL4VAD/configs.py.
#   UCF-Crime:    /data/ucf-crime/features/i3d
#   ShanghaiTech: /data/shanghaitech/features/i3d
PEL4VAD_FEAT_PREFIX=/data/ucf-crime/features/i3d

# 0 desliga o pin_memory do DataLoader do PEL4VAD. Necessário no WSL2, onde
# a memória pinned do CUDA é limitada e o treino quebra com "out of memory"
# no THCCachingHostAllocator. Não altera resultados.
PEL4VAD_PIN_MEMORY=1
